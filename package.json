{
  "name": "@ScaffoldStack/dev-wizard-engine",
  "version": "0.0.8",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./loader/*": {
      "types": "./dist/loader/*.d.ts",
      "import": "./dist/loader/*.js",
      "default": "./dist/loader/*.js"
    },
    "./loader/*.js": {
      "types": "./dist/loader/*.d.ts",
      "import": "./dist/loader/*.js",
      "default": "./dist/loader/*.js"
    },
    "./programmatic/*": {
      "types": "./dist/programmatic/*.d.ts",
      "import": "./dist/programmatic/*.js",
      "default": "./dist/programmatic/*.js"
    },
    "./programmatic/*.js": {
      "types": "./dist/programmatic/*.d.ts",
      "import": "./dist/programmatic/*.js",
      "default": "./dist/programmatic/*.js"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "import": "./dist/runtime/*.js",
      "default": "./dist/runtime/*.js"
    },
    "./runtime/*.js": {
      "types": "./dist/runtime/*.d.ts",
      "import": "./dist/runtime/*.js",
      "default": "./dist/runtime/*.js"
    },
    "./runtime/telemetry/*": {
      "types": "./dist/runtime/telemetry/*.d.ts",
      "import": "./dist/runtime/telemetry/*.js",
      "default": "./dist/runtime/telemetry/*.js"
    },
    "./runtime/telemetry/*.js": {
      "types": "./dist/runtime/telemetry/*.d.ts",
      "import": "./dist/runtime/telemetry/*.js",
      "default": "./dist/runtime/telemetry/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json --pretty false --incremental --tsBuildInfoFile /home/math/projects/dev-workspace/.dev-wizard/cache/tsbuildinfo/_ScaffoldStack_dev-wizard-engine.tsbuildinfo",
    "clean": "rimraf dist src/**/*.js src/**/*.js.map src/**/*.d.ts",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "clean:all": "rm -rf ./node_modules .pnpm-store .turbo .turbo-cache .cache .next .output dist build coverage .reports",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm exec vitest run --passWithNoTests --config /home/math/projects/dev-workspace/packages/dev-wizard-engine/tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "build:quick": "pnpm exec tsc -p tsconfig.build.json --pretty false --incremental --tsBuildInfoFile /home/math/projects/dev-workspace/.dev-wizard/cache/tsbuildinfo/_ScaffoldStack_dev-wizard-engine.tsbuildinfo",
    "build:turbo": "TURBO_TS_CONFIG=tsconfig.build.json pnpm dlx turbo run build --filter @ScaffoldStack/dev-wizard-engine || pnpm exec tsc -p tsconfig.build.json --pretty false --incremental --tsBuildInfoFile /home/math/projects/dev-workspace/.dev-wizard/cache/tsbuildinfo/_ScaffoldStack_dev-wizard-engine.tsbuildinfo",
    "test:quick": "pnpm exec vitest run --passWithNoTests --changed --config /home/math/projects/dev-workspace/packages/dev-wizard-engine/tsconfig.test.json",
    "test:turbo": "pnpm dlx turbo run test --filter @ScaffoldStack/dev-wizard-engine"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "handlebars": "^4.7.8",
    "json5": "^2.2.3",
    "semver": "^7.7.3",
    "yaml": "^2.8.2",
    "zod": "^4.2.1",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/semver": "^7.7.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
